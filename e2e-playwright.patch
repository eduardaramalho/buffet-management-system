+import { defineConfig, devices } from '@playwright/test'
+import { FRONTEND_ROOT, e2eEnv } from './support/env'
+
+export default defineConfig({
+  testDir: './tests',
+  // A jornada é uma sequência de passos dependentes sobre o mesmo banco: nada roda em paralelo.
+  fullyParallel: false,
+  workers: 1,
+  // Sem retry: repetir a jornada sobre um banco já alterado mascara falhas (e estoura o limite de login).
+  retries: 0,
+  forbidOnly: Boolean(process.env.CI),
+  timeout: 120_000,
+  expect: { timeout: 10_000 },
+  reporter: process.env.CI ? [['github'], ['html', { open: 'never' }]] : [['list'], ['html', { open: 'never' }]],
+  use: {
+    baseURL: e2eEnv.frontendUrl,
+    locale: 'pt-BR',
+    timezoneId: 'America/Sao_Paulo',
+    trace: 'retain-on-failure',
+    screenshot: 'only-on-failure',
+    video: 'retain-on-failure',
+  },
+  projects: [{ name: 'chromium', use: { ...devices['Desktop Chrome'] } }],
+  webServer: [
+    {
+      command: 'npx tsx scripts/start-backend.ts',
+      url: `${e2eEnv.backendUrl}/api/v1/health`,
+      // Nunca reaproveita um servidor já aberto: ele poderia estar ligado ao banco de desenvolvimento.
+      reuseExistingServer: false,
+      timeout: 180_000,
+      stdout: 'pipe',
+      stderr: 'pipe',
+    },
+    {
+      command: `npx vite --port ${e2eEnv.frontendPort} --strictPort`,
+      cwd: FRONTEND_ROOT,
+      url: e2eEnv.frontendUrl,
+      reuseExistingServer: false,
+      timeout: 120_000,
+      env: { VITE_PROXY_TARGET: e2eEnv.backendUrl },
+    },
+  ],
+})
diff --git a/apps/e2e/scripts/start-backend.ts b/apps/e2e/scripts/start-backend.ts
new file mode 100644
index 0000000..4aa43c9
--- /dev/null
+++ b/apps/e2e/scripts/start-backend.ts
@@ -0,0 +1,27 @@
+// Sobe o backend para os testes E2E: recria o banco de testes do zero, aplica o seed e inicia a API.
+// Executado pelo webServer do Playwright, então o banco é sempre resetado ANTES da API aceitar requisições.
+import { execSync, spawn } from 'node:child_process'
+import { BACKEND_ROOT, e2eEnv } from '../support/env.js'
+
+const env = {
+  ...process.env,
+  DATABASE_URL: e2eEnv.databaseUrl,
+  PORT: String(e2eEnv.backendPort),
+  JWT_ACCESS_SECRET: process.env.JWT_ACCESS_SECRET ?? 'e2e-only-access-secret',
+  JWT_ACCESS_TTL: '15m',
+  CORS_ORIGIN: e2eEnv.frontendUrl,
+  LOG_LEVEL: process.env.LOG_LEVEL ?? 'warn',
+  NODE_ENV: 'test',
+}
+
+const run = (command: string) => execSync(command, { cwd: BACKEND_ROOT, env, stdio: 'inherit' })
+
+run('npx prisma migrate reset --force')
+run('npx prisma generate')
+run('npx tsx prisma/seed.ts')
+
+const server = spawn('npx', ['tsx', 'src/server.ts'], { cwd: BACKEND_ROOT, env, stdio: 'inherit', shell: true })
+const stop = () => server.kill()
+process.on('SIGINT', stop)
+process.on('SIGTERM', stop)
+server.on('exit', (code) => process.exit(code ?? 0))
diff --git a/apps/e2e/support/api.ts b/apps/e2e/support/api.ts
new file mode 100644
index 0000000..b0bedc2
--- /dev/null
+++ b/apps/e2e/support/api.ts
@@ -0,0 +1,38 @@
+import { expect, request, type APIRequestContext, type APIResponse } from '@playwright/test'
+import { e2eEnv } from './env'
+
+type Credentials = { email: string; password: string }
+
+/**
+ * Cliente HTTP da suíte, usado para preparar dados e verificar regras que a interface não expõe
+ * (ex.: conflito de agenda e RBAC no backend). O que o usuário faz pela tela é testado pela tela.
+ */
+export class ApiClient {
+  private constructor(private readonly context: APIRequestContext) {}
+
+  static async login(credentials: Credentials) {
+    const anonymous = await request.newContext({ baseURL: e2eEnv.backendUrl })
+    const response = await anonymous.post('/api/v1/auth/login', { data: credentials })
+    await expectStatus(response, 200)
+    const { accessToken } = await response.json() as { accessToken: string }
+    await anonymous.dispose()
+    const context = await request.newContext({ baseURL: e2eEnv.backendUrl, extraHTTPHeaders: { Authorization: `Bearer ${accessToken}` } })
+    return new ApiClient(context)
+  }
+
+  get(path: string) { return this.context.get(`/api/v1${path}`) }
+  post(path: string, data?: unknown) { return this.context.post(`/api/v1${path}`, { data }) }
+
+  async json<T>(response: Promise<APIResponse>, status = 200): Promise<T> {
+    const resolved = await response
+    await expectStatus(resolved, status)
+    return await resolved.json() as T
+  }
+
+  dispose() { return this.context.dispose() }
+}
+
+export async function expectStatus(response: APIResponse, status: number) {
+  // Mostra o corpo na falha: sem isso, um 422 vira só "expected 201, received 422".
+  expect(response.status(), `${response.url()} -> ${await response.text()}`).toBe(status)
+}
