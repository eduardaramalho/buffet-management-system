diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 6ec6d83..3ae1061 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -86,6 +86,67 @@ jobs:
           path: apps/frontend/coverage
           if-no-files-found: error
 
+  e2e:
+    needs: [backend, frontend]
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    services:
+      mysql:
+        image: mysql:8
+        env:
+          MYSQL_ROOT_PASSWORD: e2e-root-password
+        ports:
+          - 3306:3306
+        options: >-
+          --health-cmd="mysqladmin ping -h localhost -uroot -pe2e-root-password --silent"
+          --health-interval=5s --health-timeout=5s --health-retries=20
+    env:
+      E2E_DATABASE_URL: mysql://root:e2e-root-password@127.0.0.1:3306/buffet_management_e2e
+      E2E_BACKEND_PORT: 3100
+      E2E_FRONTEND_PORT: 5174
+      JWT_ACCESS_SECRET: ci-only-e2e-access-secret
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 24.x
+          cache: npm
+          cache-dependency-path: |
+            apps/backend/package-lock.json
+            apps/frontend/package-lock.json
+            apps/e2e/package-lock.json
+
+      - name: Install dependencies
+        run: |
+          npm ci --prefix apps/backend
+          npm ci --prefix apps/frontend
+          npm ci --prefix apps/e2e
+
+      - name: Install Playwright browser
+        working-directory: apps/e2e
+        run: npx playwright install --with-deps chromium
+
+      - name: Typecheck E2E suite
+        working-directory: apps/e2e
+        run: npm run typecheck
+
+      - name: Run E2E journey
+        working-directory: apps/e2e
+        run: npm test
+
+      - name: Upload Playwright report
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: playwright-report
+          path: |
+            apps/e2e/playwright-report
+            apps/e2e/test-results
+          if-no-files-found: ignore
+
   sonar:
     needs: [backend, frontend]
     runs-on: ubuntu-latest
diff --git a/apps/e2e/.env.e2e.example b/apps/e2e/.env.e2e.example
new file mode 100644
index 0000000..d3fc6b0
--- /dev/null
+++ b/apps/e2e/.env.e2e.example
@@ -0,0 +1,8 @@
+# Banco EXCLUSIVO dos testes E2E. Ele é apagado e recriado a cada execução.
+# Por segurança, o nome do banco precisa conter "e2e" (veja support/env.ts).
+# O usuário precisa de permissão para criar/apagar o banco (ex.: root no MySQL local).
+E2E_DATABASE_URL=mysql://root:change-this-root-password@localhost:3306/buffet_management_e2e
+
+# Portas dedicadas para não reaproveitar o backend/frontend de desenvolvimento por engano.
+E2E_BACKEND_PORT=3100
+E2E_FRONTEND_PORT=5174
