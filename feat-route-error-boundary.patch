diff --git a/apps/frontend/src/components/RouteErrorBoundary.test.tsx b/apps/frontend/src/components/RouteErrorBoundary.test.tsx
new file mode 100644
index 0000000..e44647b
--- /dev/null
+++ b/apps/frontend/src/components/RouteErrorBoundary.test.tsx
@@ -0,0 +1,50 @@
+import { fireEvent, render, screen } from '@testing-library/react'
+import { MemoryRouter } from 'react-router-dom'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { RouteErrorBoundary } from './RouteErrorBoundary'
+
+let shouldThrow = true
+function UnstablePage() {
+  if (shouldThrow) throw new RangeError('Invalid time value')
+  return <h1>Página carregada</h1>
+}
+const renderBoundary = (resetKey = '/events/1') => render(
+  <MemoryRouter><RouteErrorBoundary resetKey={resetKey}><UnstablePage /></RouteErrorBoundary></MemoryRouter>,
+)
+
+describe('RouteErrorBoundary', () => {
+  beforeEach(() => {
+    shouldThrow = true
+    // O React registra no console todo erro capturado por um boundary; aqui o erro é esperado.
+    vi.spyOn(console, 'error').mockImplementation(() => undefined)
+  })
+  afterEach(() => vi.restoreAllMocks())
+
+  it('shows a recoverable message instead of a blank screen when the page throws', () => {
+    renderBoundary()
+
+    expect(screen.getByRole('alert')).toHaveTextContent('Não foi possível exibir esta tela.')
+    expect(screen.getByRole('button', { name: 'Tentar de novo' })).toBeInTheDocument()
+    expect(screen.getByRole('link', { name: 'Ir para o início' })).toHaveAttribute('href', '/')
+    // Detalhes técnicos ficam fora da tela.
+    expect(screen.queryByText(/Invalid time value/)).not.toBeInTheDocument()
+  })
+
+  it('remounts the page when the user retries, without reloading the browser', () => {
+    renderBoundary()
+    shouldThrow = false
+
+    fireEvent.click(screen.getByRole('button', { name: 'Tentar de novo' }))
+
+    expect(screen.getByRole('heading', { name: 'Página carregada' })).toBeInTheDocument()
+  })
+
+  it('clears the error when the route changes', () => {
+    const { rerender } = renderBoundary('/events/1')
+    shouldThrow = false
+
+    rerender(<MemoryRouter><RouteErrorBoundary resetKey="/tasks"><UnstablePage /></RouteErrorBoundary></MemoryRouter>)
+
+    expect(screen.getByRole('heading', { name: 'Página carregada' })).toBeInTheDocument()
+  })
+})
diff --git a/apps/frontend/src/components/RouteErrorBoundary.tsx b/apps/frontend/src/components/RouteErrorBoundary.tsx
new file mode 100644
index 0000000..7d1b390
--- /dev/null
+++ b/apps/frontend/src/components/RouteErrorBoundary.tsx
@@ -0,0 +1,47 @@
+import { Component, Fragment, type ErrorInfo, type ReactNode } from 'react'
+import { Link } from 'react-router-dom'
+
+type Props = { children: ReactNode; resetKey: string }
+type State = { failed: boolean; attempt: number }
+
+/**
+ * Contém erros de renderização de uma tela dentro da área de conteúdo.
+ * Sem ele, o React desmonta a aplicação inteira (tela branca) e, como os tokens ficam só em memória,
+ * o usuário perde a sessão ao recarregar. Aqui o menu e a sessão continuam ativos.
+ *
+ * Error Boundaries ainda exigem componente de classe: não há hook equivalente no React.
+ */
+export class RouteErrorBoundary extends Component<Props, State> {
+  state: State = { failed: false, attempt: 0 }
+
+  static getDerivedStateFromError(): Partial<State> {
+    return { failed: true }
+  }
+
+  componentDidCatch(error: Error, info: ErrorInfo) {
+    // Fica no console do navegador para diagnóstico; a tela mostra apenas uma mensagem amigável.
+    console.error('Erro ao renderizar a tela', error, info.componentStack)
+  }
+
+  componentDidUpdate(previous: Props) {
+    // Ao navegar para outra rota, a nova tela começa sem o erro da anterior.
+    if (previous.resetKey !== this.props.resetKey && this.state.failed) this.setState({ failed: false })
+  }
+
+  private retry = () => this.setState((current) => ({ failed: false, attempt: current.attempt + 1 }))
+
+  render() {
+    if (this.state.failed) {
+      return <main className="app-shell"><section className="route-error" role="alert">
+        <h1>Não foi possível exibir esta tela.</h1>
+        <p className="muted">Os seus dados estão salvos. Tente carregar a tela de novo ou volte ao início.</p>
+        <div className="form-actions">
+          <Link className="link-button" to="/">Ir para o início</Link>
+          <button type="button" className="secondary" onClick={this.retry}>Tentar de novo</button>
+        </div>
+      </section></main>
+    }
+    // A key muda a cada tentativa: a tela é montada do zero, refazendo as requisições.
+    return <Fragment key={this.state.attempt}>{this.props.children}</Fragment>
+  }
+}
