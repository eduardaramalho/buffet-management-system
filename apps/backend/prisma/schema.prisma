// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
}

model User {
  id                    String         @id @default(uuid()) @db.Char(36)
  name                  String         @db.VarChar(150)
  email                 String         @unique @db.VarChar(150)
  passwordHash          String         @map("password_hash") @db.VarChar(255)
  isActive              Boolean        @default(true) @map("is_active")
  // ADR 0012: true enquanto o usuário não troca a senha temporária gerada pelo administrador.
  mustChangePassword    Boolean        @default(false) @map("must_change_password")
  tempPasswordExpiresAt DateTime?      @map("temp_password_expires_at")
  deletedAt             DateTime?      @map("deleted_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  roles                 UserRole[]
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]     @relation("AuditActor")
  assignedRoles         UserRole[]     @relation("RoleAssigner")
  createdEvents         Event[]        @relation("EventCreator")
  createdTeams          Team[]         @relation("TeamCreator")
  assignedEventTeams    EventTeam[]    @relation("TeamAssigner")
  createdRules          Rule[]         @relation("RuleCreator")

  @@index([deletedAt])
  @@map("users")
}

enum EventType {
  CASAMENTO
  ANIVERSARIO
  FORMATURA
  CORPORATIVO
  CONFRATERNIZACAO
  BATIZADO
  OUTRO
}

enum EventStatus {
  PLANEJAMENTO
  CONFIRMADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum ClientType {
  PF
  PJ
}

// document is stored without punctuation (CPF: 11 digits, CNPJ: 14 chars, alphanumeric since 07/2026).
// The unique index is global (soft-deleted rows included): MySQL treats NULLs as distinct, so clients
// without a document never collide.
model Client {
  id        String     @id @default(uuid()) @db.Char(36)
  type      ClientType
  name      String     @db.VarChar(150)
  document  String?    @unique @db.VarChar(14)
  email     String?    @db.VarChar(150)
  phone     String?    @db.VarChar(30)
  notes     String?    @db.Text
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  events    Event[]

  @@index([name])
  @@index([deletedAt])
  @@map("clients")
}

model Event {
  id               String            @id @default(uuid()) @db.Char(36)
  name             String            @db.VarChar(150)
  eventDate        DateTime          @map("event_date")
  endDate          DateTime?         @map("end_date")
  location         String            @db.VarChar(200)
  serviceType      EventType         @map("service_type")
  guestsCount      Int               @map("guests_count")
  observations     String?           @db.Text
  status           EventStatus       @default(PLANEJAMENTO)
  // Nullable on purpose (expand/contract, ADR 0005): required by the application for new events;
  // a later migration makes it NOT NULL once legacy events are linked to a client.
  clientId         String?           @map("client_id") @db.Char(36)
  // RF25 (ADR 0008): event used as the base of this one. Restrict keeps the lineage forever;
  // business data is never physically deleted (soft delete, RNF07).
  sourceEventId    String?           @map("source_event_id") @db.Char(36)
  createdById      String            @map("created_by_id") @db.Char(36)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  createdBy        User              @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sourceEvent      Event?            @relation("EventReplication", fields: [sourceEventId], references: [id], onDelete: Restrict)
  replicas         Event[]           @relation("EventReplication")
  services         EventService[]
  teams            EventTeam[]
  tasks            Task[]
  ruleApplications RuleApplication[]

  @@index([createdById])
  @@index([clientId])
  @@index([sourceEventId])
  @@index([status])
  @@index([eventDate])
  @@index([deletedAt])
  @@map("events")
}

// Service is a catalog table instead of a fixed enum so services can be reused,
// reported on in the future, and added by managers without a new deployment.
model Service {
  id        String         @id @default(uuid()) @db.Char(36)
  name      String         @db.VarChar(100)
  isCustom  Boolean        @default(false) @map("is_custom")
  createdAt DateTime       @default(now()) @map("created_at")
  deletedAt DateTime?      @map("deleted_at")
  events    EventService[]

  @@index([deletedAt])
  @@map("services")
}

model EventService {
  eventId     String  @map("event_id") @db.Char(36)
  serviceId   String  @map("service_id") @db.Char(36)
  customLabel String? @map("custom_label") @db.VarChar(255)
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([eventId, serviceId])
  @@index([serviceId])
  @@map("event_services")
}

enum TeamSpecialty {
  COZINHA
  SALAO
  BAR
  DECORACAO
  LIMPEZA
  CERIMONIAL
  OUTRO
}

enum TeamStatus {
  ATIVA
  INATIVA
}

enum CollaboratorStatus {
  ATIVO
  INATIVO
}

// Collaborators do not need system access, so they are kept separate from User.
model Collaborator {
  id        String             @id @default(uuid()) @db.Char(36)
  name      String             @db.VarChar(150)
  phone     String?            @db.VarChar(30)
  position  String             @db.VarChar(100)
  status    CollaboratorStatus @default(ATIVO)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  deletedAt DateTime?          @map("deleted_at")
  teams     TeamMember[]

  @@index([status])
  @@index([deletedAt])
  @@map("collaborators")
}

// Teams are reusable operational groups; their specialty is fixed at registration.
model Team {
  id           String        @id @default(uuid()) @db.Char(36)
  name         String        @db.VarChar(150)
  specialty    TeamSpecialty
  status       TeamStatus    @default(ATIVA)
  observations String?       @db.Text
  createdById  String        @map("created_by_id") @db.Char(36)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  createdBy    User          @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members      TeamMember[]
  events       EventTeam[]
  tasks        Task[]

  @@index([createdById])
  @@index([specialty])
  @@index([status])
  @@index([deletedAt])
  @@map("teams")
}

// isLeader identifies the operational contact without imposing a single leader constraint.
model TeamMember {
  teamId         String       @map("team_id") @db.Char(36)
  collaboratorId String       @map("collaborator_id") @db.Char(36)
  isLeader       Boolean      @default(false) @map("is_leader")
  addedAt        DateTime     @default(now()) @map("added_at")
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)

  @@id([teamId, collaboratorId])
  @@index([collaboratorId])
  @@map("team_members")
}

// Event assignment stores history; overlap and terminal-event rules belong to the service layer.
model EventTeam {
  eventId      String   @map("event_id") @db.Char(36)
  teamId       String   @map("team_id") @db.Char(36)
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String   @map("assigned_by_id") @db.Char(36)
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignedBy   User     @relation("TeamAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([eventId, teamId])
  @@index([teamId])
  @@index([assignedById])
  @@map("event_teams")
}

model Role {
  id          String           @id @default(uuid()) @db.Char(36)
  name        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(255)
  isProtected Boolean          @default(false) @map("is_protected")
  deletedAt   DateTime?        @map("deleted_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  key         String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId         String   @map("user_id") @db.Char(36)
  roleId         String   @map("role_id") @db.Char(36)
  assignedAt     DateTime @default(now()) @map("assigned_at")
  assignedBy     String?  @map("assigned_by") @db.Char(36)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User?    @relation("RoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([assignedBy])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Char(36)
  permissionId String     @map("permission_id") @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  tokenHash   String    @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdByIp String?   @map("created_by_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// The condition is embedded directly in Rule (not a separate RuleCondition table) because a rule
// has exactly one condition set — there is no N:N cardinality to justify normalizing it away.
model Rule {
  id                          String                    @id @default(uuid()) @db.Char(36)
  name                        String                    @db.VarChar(150)
  description                 String?                   @db.Text
  isActive                    Boolean                   @default(true) @map("is_active")
  conditionServiceTypeIn      Json?                     @map("condition_service_type_in")
  conditionMinGuests          Int?                      @map("condition_min_guests")
  conditionMaxGuests          Int?                      @map("condition_max_guests")
  conditionRequiredServiceIds Json?                     @map("condition_required_service_ids")
  createdById                 String                    @map("created_by_id") @db.Char(36)
  createdAt                   DateTime                  @default(now()) @map("created_at")
  updatedAt                   DateTime                  @updatedAt @map("updated_at")
  deletedAt                   DateTime?                 @map("deleted_at")
  createdBy                   User                      @relation("RuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  resourceRequirements        RuleResourceRequirement[]
  taskTemplates               RuleTaskTemplate[]
  applications                RuleApplication[]
  generatedTasks              Task[]

  @@index([createdById])
  @@index([isActive])
  @@index([deletedAt])
  @@map("rules")
}

// Logical N:N between Rule and TeamSpecialty — a rule may require more than one specialty.
model RuleResourceRequirement {
  id          String        @id @default(uuid()) @db.Char(36)
  ruleId      String        @map("rule_id") @db.Char(36)
  specialty   TeamSpecialty
  minQuantity Int           @default(1) @map("min_quantity")
  rule        Rule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([specialty])
  @@map("rule_resource_requirements")
}

// Template for a Task spawned when a Rule is applied to an Event. daysBeforeEvent is nullable
// because some tasks are plain alerts with no relative deadline (task is created without a dueDate).
model RuleTaskTemplate {
  id              String         @id @default(uuid()) @db.Char(36)
  ruleId          String         @map("rule_id") @db.Char(36)
  title           String         @db.VarChar(150)
  description     String?        @db.Text
  daysBeforeEvent Int?           @map("days_before_event")
  // RFC 3.1 (ADR 0010): specialty whose allocated team receives the generated task. Null keeps the
  // task unassigned (plain reminder). Must be one of the rule's resource requirements.
  specialty       TeamSpecialty?
  rule            Rule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("rule_task_templates")
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

// assignedTeamId is nullable: a task with no team is an alert-only task (e.g. a reminder) rather
// than an operational assignment. sourceRuleId is nullable to allow future manual task creation,
// even though today every task is spawned from a Rule.
model Task {
  id             String     @id @default(uuid()) @db.Char(36)
  eventId        String     @map("event_id") @db.Char(36)
  title          String     @db.VarChar(150)
  description    String?    @db.Text
  dueDate        DateTime?  @map("due_date")
  completedAt    DateTime?  @map("completed_at")
  status         TaskStatus @default(PENDENTE)
  assignedTeamId String?    @map("assigned_team_id") @db.Char(36)
  // Set when the team is assigned or changed, cleared when unassigned (average assignment time report).
  assignedAt     DateTime?  @map("assigned_at")
  sourceRuleId   String?    @map("source_rule_id") @db.Char(36)
  // RF25 (ADR 0008): manual task this one was copied from when its event was replicated.
  sourceTaskId   String?    @map("source_task_id") @db.Char(36)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")
  event          Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedTeam   Team?      @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  sourceRule     Rule?      @relation(fields: [sourceRuleId], references: [id], onDelete: SetNull)
  sourceTask     Task?      @relation("TaskReplication", fields: [sourceTaskId], references: [id], onDelete: Restrict)
  replicas       Task[]     @relation("TaskReplication")

  @@index([eventId])
  @@index([assignedTeamId])
  @@index([sourceRuleId])
  @@index([sourceTaskId])
  @@index([status])
  @@index([deletedAt])
  @@map("tasks")
}

// Idempotency guard: a Rule can only generate tasks for a given Event once, unless the prior
// application row is explicitly removed to allow a forced reprocessing.
model RuleApplication {
  id        String   @id @default(uuid()) @db.Char(36)
  eventId   String   @map("event_id") @db.Char(36)
  ruleId    String   @map("rule_id") @db.Char(36)
  appliedAt DateTime @default(now()) @map("applied_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rule      Rule     @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([eventId, ruleId])
  @@index([ruleId])
  @@map("rule_applications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @map("user_id") @db.Char(36)
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.Char(36)
  changes   Json?
  createdAt DateTime @default(now()) @map("created_at")
  actor     User?    @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
