DATABASE_URL="mysql://user:password@localhost:3306/buffet_management"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_MS="604800000"
PORT="3000"
# Senha do usuário admin@buffet.local, usada pelo seed apenas quando o administrador ainda não existe (mínimo 8 caracteres).
ADMIN_INITIAL_PASSWORD="Admin123!"
# Quantidade de proxies reversos na frente da API. 0 em desenvolvimento local (ADR 0011).
TRUST_PROXY="0"# Atributo Secure do cookie do refresh token (ADR 0020). Sem valor: true em NODE_ENV=production e false fora dele.
# Use false só em HTTP local; em produção o Caddy serve HTTPS e o cookie precisa ser Secure.
COOKIE_SECURE=""
