# MySQL
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=buffet_management
MYSQL_USER=buffet
MYSQL_PASSWORD=change-this-database-password

# Backend
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_MS=604800000
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info
# Senha do usuário admin@buffet.local, usada pelo seed apenas quando o administrador ainda não existe (mínimo 8 caracteres).
ADMIN_INITIAL_PASSWORD=change-this-admin-password
# Quantidade de proxies reversos na frente da API. 0 quando o navegador acessa a API diretamente (ADR 0011).
TRUST_PROXY=0
NODE_ENV=production
BACKEND_PORT=3000

# Frontend (this URL is resolved by the user's browser)
VITE_API_URL=http://localhost:3000
FRONTEND_PORT=8080

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin